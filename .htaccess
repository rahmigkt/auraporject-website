Options -Indexes
DirectoryIndex index.html

# Always HTTPS (certificate verified on the phone 2026-10-20)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# The site is the former /w4/ edition: old addresses lead to the same pages; pages of the previous site lead home.
<IfModule mod_alias.c>
RedirectMatch 301 ^/w4/?(.*)$ /$1
RedirectMatch 301 ^/(felsefe|gonye|iskarpela|kategori|kavela|masif|verev|sepet)\.html$ /
RedirectMatch 301 ^/(2|3|ornek|admin)(/.*)?$ /
</IfModule>
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(self), geolocation=()"
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(html|js|css)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>
